# -----------------------------------------------------------------------------
# Configuration
# -----------------------------------------------------------------------------
# Main application configuration file.
# The application loads this file and expands ${VAR} placeholders
# using the current process environment.
CONFIG_FILE=configs/config.yaml

# Deployment runtime environment mapped to runtime.environment in config.yaml.
# Used for production guards and environment-specific policy validation.
#
# Supported values:
#   development   local development (default for .env.example)
#   test          automated test runs
#   staging       pre-production integration environments
#   production    live production deployments
#
# Production effects (when MESSAGING_PROVIDER=kafka):
#   - consumer initial_offset=newest is rejected at startup to avoid skipping backlog
#
# Use development for local docker-compose and workstation runs.
APP_ENVIRONMENT=development

# Application executable path.
# Override this value only if the application binary path changes.
APP_EXECUTABLE=./build/bin/bnpl

# -----------------------------------------------------------------------------
# PostgreSQL Bootstrap
# -----------------------------------------------------------------------------
# Used by local docker-compose and database initialization.
POSTGRES_DB=bnpl_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_SSL_MODE=disable

# -----------------------------------------------------------------------------
# PostgreSQL Application Configuration
# -----------------------------------------------------------------------------
# Database host reachable by the application.
POSTGRES_HOST=127.0.0.1

# Database port.
POSTGRES_PORT=5432

# Maximum number of open connections.
POSTGRES_MAX_CONNECTIONS=10

# Minimum number of idle connections.
POSTGRES_MIN_CONNECTIONS=1

# Maximum lifetime of a connection.
POSTGRES_MAX_CONNECTION_LIFE_TIME=3600s

# Maximum idle time before a connection is recycled.
POSTGRES_MAX_CONNECTION_IDLE_TIME=1800s

# Period between database health checks.
POSTGRES_HEALTH_CHECK_PERIOD=60s

# Connection establishment timeout.
POSTGRES_CONNECTION_TIMEOUT=30s

# Enable diagnostic PostgreSQL query logging through the application logger.
# This setting is rejected at startup when APP_ENVIRONMENT=production.
POSTGRES_QUERY_LOGGING_ENABLED=false

# When query logging is enabled, render bound arguments into a logging-only SQL
# representation. Query execution itself remains parameterized by pgx.
POSTGRES_QUERY_LOGGING_INCLUDE_ARGUMENTS=true

# PostgreSQL password entries in the following format:
# host:port:database:user:password
POSTGRES_ADMIN_PGPASS=127.0.0.1:5432:bnpl_db:admin:change-me
POSTGRES_NORMAL_PGPASS=127.0.0.1:5432:bnpl_db:bnpl:change-me

# -----------------------------------------------------------------------------
# HTTP Server (Gin)
# -----------------------------------------------------------------------------
# Address to bind the HTTP server.
GIN_HOST=127.0.0.1

# Listening port.
GIN_PORT=8080

# Trusted reverse proxy.
GIN_TRUSTED_PROXY=127.0.0.1

# debug | release | test
GIN_MODE=debug

# Enable request logging middleware.
GIN_LOGGER=true

# Maximum time allowed to read request headers (mitigates Slowloris).
GIN_READ_HEADER_TIMEOUT=5s

# Maximum time allowed to read the complete HTTP request, including its body.
GIN_READ_TIMEOUT=15s

# Maximum time allowed to write a response. 0 disables the write deadline.
GIN_WRITE_TIMEOUT=0s

# Keep-alive idle timeout between requests on the same connection.
GIN_IDLE_TIMEOUT=60s

# Hard request-header and request-body safety bounds.
GIN_MAX_HEADER_BYTES=65536
GIN_MAX_BODY_BYTES=1048576

# Maximum requests executing concurrently inside one BNPL process.
# Saturated instances fail fast with 503 instead of building an in-memory queue.
GIN_MAX_IN_FLIGHT=256

# Default REST response language when Accept-Language/lang is missing or unsupported.
# Supported values: en-US, fa-IR (case-insensitive BCP 47 tags).
GIN_I18N_DEFAULT_LANGUAGE=en-US

# Enable the Swagger UI at /swagger/*any (serves the generated Swagger 2.0 spec).
# Disabled by default. Enable only for local or development environments.
# Production exposure must be an explicit deployment decision.
# cfg.Gin.Swagger.Enabled (this flag) is authoritative; the route is registered
# only when the flag is true. Do not infer enablement from APP_ENVIRONMENT,
# APP_MODE, or GIN_MODE.
GIN_SWAGGER_ENABLED=true

# Enable Development-only HTTPDebugLogger (full unredacted HTTP exchange).
# WARNING: Captures credentials, OTPs, customer data, and secrets without
# redaction. Enable only temporarily in controlled development environments
# with test data. Do not use with production credentials or real customer data.
# Do not forward these logs to shared/centralized collectors without controls.
# Requires a development build; production rejects enabled=true.
# Do not enable based on GIN_MODE or environment name.
GIN_HTTP_DEBUG_LOGGER_ENABLED=false

# Maximum request/response body bytes retained in HTTPDebugLogger diagnostics.
# Client-visible HTTP traffic is never truncated; only the log capture is capped.
GIN_HTTP_DEBUG_LOGGER_MAX_REQUEST_BODY_BYTES=65536
GIN_HTTP_DEBUG_LOGGER_MAX_RESPONSE_BODY_BYTES=65536

# Optional allowlisted response-body enrichment of AccessLogger records.
# Available in Production. Disabled by default. Requires GIN_LOGGER=true.
# Unknown routes/fields fail closed with an explicit omission reason.
GIN_RESPONSE_LOGGING_ENABLED=false
GIN_RESPONSE_LOGGING_MAX_BODY_BYTES=16384

# -----------------------------------------------------------------------------
# Graceful Shutdown
# -----------------------------------------------------------------------------
# Maximum time allowed for graceful shutdown before the application is
# considered unhealthy and external supervisors may terminate the process.
SHUTDOWN_TIMEOUT=30s

# Delay after readiness starts failing and before the HTTP server begins
# shutdown, giving load balancers time to stop routing new traffic.
SHUTDOWN_DRAIN_DELAY=5s

# -----------------------------------------------------------------------------
# Health Checks Use Case
# -----------------------------------------------------------------------------
# Enable application health checks and expose readiness/liveness endpoints.
HEALTH_ENABLED=true
# Externally reachable origin for the BNPL hosted checkout UI (scheme://host[:port]).
# Must be an origin only — no path, query, fragment, or trailing slash.
# Changing this to an origin whose host is not in the production allowlist causes
# startup to fail (intentional).
CHECKOUT_SESSION_PUBLIC_ORIGIN=https://api.bnpl.test:8443
# Exact hostname allowlist entry for public_origin validation (independent of the
# origin ENV value). Add more YAML list entries for additional hosts.
CHECKOUT_SESSION_PUBLIC_ORIGIN_ALLOWED_HOST=api.bnpl.test
CHECKOUT_SESSION_TTL=30m
CHECKOUT_SESSION_EXPIRY_BATCH_SIZE=100
# Webhook signing-secret encryption at rest (AES-256-GCM). Keys are
# "id:base64(32 bytes)" pairs separated by commas; generate one with:
#   openssl rand -base64 32
# Rotate by adding a new key, switching ACTIVE_KEY_ID, and keeping old keys until
# no stored secret references them.
WEBHOOK_SECRET_ENCRYPTION_ACTIVE_KEY_ID=dev1
WEBHOOK_SECRET_ENCRYPTION_KEYS=dev1:ZGV2LW9ubHktd2ViaG9vay1lbmNyeXB0aW9uLWtleSE=
# Customer phone encryption at rest (AES-256-GCM) for external partner checkouts.
# Same format and rotation rules as the webhook keys above, but a separate key
# ring: generate a distinct key with `openssl rand -base64 32`.
CUSTOMER_PHONE_ENCRYPTION_ACTIVE_KEY_ID=dev1
CUSTOMER_PHONE_ENCRYPTION_KEYS=dev1:ZGV2LW9ubHktY3VzdG9tZXItcGhvbmUta2V5LTAxMjM=
# External checkout OTP (hosted partner checkout phone verification).
# OTP lifetime, attempt budget, and send limits are immutable security policy
# (checkoutotp.V1) and are intentionally not configurable. The logical template
# is submitted through the Notification Service (variables: code, merchant_name).
CHECKOUT_SESSION_OTP_TEMPLATE_ID=bnpl.external_checkout_otp.v1
# OTP digests are HMAC-SHA256 keyed by a versioned pepper ring. Keys are
# "id:secret" pairs separated by commas; secrets must be >= 32 bytes and must not
# contain commas. Rotate by adding the new key, switching ACTIVE_PEPPER_KEY_ID,
# and removing the old key once its OTPs have expired.
CHECKOUT_SESSION_OTP_ACTIVE_PEPPER_KEY_ID=dev1
CHECKOUT_SESSION_OTP_PEPPER_KEYS=dev1:dev-only-checkout-otp-pepper-32-bytes-min
# Auth tenant/context UUIDs applied to customer contexts created by hosted
# external checkout confirmation. Leave empty until the scope is provisioned.
KAFKA_TOPIC_MERCHANT_CHECKOUT_EVENTS=bnpl.merchant.checkout.events

# -----------------------------------------------------------------------------
# Merchant Terminal (usecases.merchant_terminal)
# -----------------------------------------------------------------------------
# Partners authenticate with the X-Terminal-Id and X-API-Key headers. API keys
# are stored only as HMAC-SHA256 hashes keyed by a versioned pepper key ring.
# Each pepper must be at least 32 bytes, must be kept secret, and must never be
# stored in the database. Key ids must match [A-Za-z0-9_-]{1,64} (no ':').
# Generate one with:
#   openssl rand -base64 48
# Versioned pepper key ring ("id:pepper" pairs, comma-separated):
# - active id hashes newly issued credentials
# - existing credentials keep verifying with the key id embedded in their
#   stored verifier; keep old peppers configured while dependent credentials exist
# - removing a referenced pepper fails authentication closed for those keys
# When pepper_keys is empty, MERCHANT_TERMINAL_API_KEY_PEPPER is used as "v1".
MERCHANT_TERMINAL_API_KEY_ACTIVE_PEPPER_KEY_ID=v1
MERCHANT_TERMINAL_API_KEY_PEPPER_KEYS=v1:dev-only-merchant-terminal-api-key-pepper-32b
# Deprecated single-pepper fallback (maps to v1 when pepper_keys is empty).
MERCHANT_TERMINAL_API_KEY_PEPPER=dev-only-merchant-terminal-api-key-pepper-32b
# How long a rotated API key stays accepted when the caller does not choose a
# grace period, and the longest grace period a caller may request.
MERCHANT_TERMINAL_ROTATION_DEFAULT_GRACE_PERIOD=24h
MERCHANT_TERMINAL_ROTATION_MAX_GRACE_PERIOD=168h
# How long a freshly issued API key can be replayed to an idempotent retry of
# provisioning or rotation.
MERCHANT_TERMINAL_ISSUANCE_DELIVERY_TTL=24h
# Issued API keys held for idempotent replay are encrypted at rest (AES-256-GCM).
# Keys are "id:base64(32 bytes)" pairs separated by commas; generate one with:
#   openssl rand -base64 32
# These keys are deliberately separate from the webhook secret keys. Rotate by
# adding a new key, switching ACTIVE_KEY_ID, and keeping old keys until no held
# issuance references them.
MERCHANT_TERMINAL_ISSUANCE_ENCRYPTION_ACTIVE_KEY_ID=dev1
MERCHANT_TERMINAL_ISSUANCE_ENCRYPTION_KEYS=dev1:ZGV2LW9ubHktbWVyY2hhbnQtYXV0aC1pc3N1YW5jZSE=

# -----------------------------------------------------------------------------
# Database Migrations Use Case
# -----------------------------------------------------------------------------
# Location of migration files.
MIGRATIONS_FILES_DIR=assets/db/migrations
MIGRATIONS_LOCK_TIMEOUT=30s

# ------------------------------------------------------------------------------
# Outbox Publisher Use Case
# ------------------------------------------------------------------------------
# Worker identifier used when claiming outbox rows.
OUTBOX_PUBLISHER_WORKER_ID=local

# Maximum number of messages claimed per execution.
OUTBOX_PUBLISHER_BATCH_SIZE=100

# Initial retry delay.
OUTBOX_PUBLISHER_RETRY_BASE_DELAY=1s

# Maximum retry delay.
OUTBOX_PUBLISHER_RETRY_MAX_DELAY=1m

# How long an outbox claim lease remains valid before another worker may reclaim the row.
OUTBOX_PUBLISHER_PROCESSING_LEASE_TIMEOUT=5m

# ------------------------------------------------------------------------------
# Saga Executor Use Case
# ------------------------------------------------------------------------------
SAGA_EXECUTOR_WORKER_ID=saga-executor
SAGA_EXECUTOR_BATCH_SIZE=10
SAGA_EXECUTOR_LEASE_DURATION=2m

# ------------------------------------------------------------------------------
# Checkout Installment Offer Use Case
# ------------------------------------------------------------------------------
# Batch size for scheduled -> due maintenance job.
INSTALLMENT_MARK_DUE_BATCH_SIZE=100

# Batch size for due -> overdue maintenance job.
INSTALLMENT_MARK_OVERDUE_BATCH_SIZE=100

# ------------------------------------------------------------------------------
# Contract Use Case
# ------------------------------------------------------------------------------
# Operational tolerance for delayed Financial Core payment-result processing (0-60m).
# This is not the contractual customer grace period on installments.
CONTRACT_PAYMENT_RESULT_PROCESSING_GRACE_PERIOD=5m

# Batch size for payment_pending contract expiry job.
CONTRACT_EXPIRY_BATCH_SIZE=100

# Maximum canceling contracts claimed per cancellation dispatch job run.

# How long a cancellation dispatch claim lease remains valid.

# Initial delay before the next cancellation dispatch retry.
CONTRACT_CANCELLATION_SAGA_RETRY_BASE_DELAY=1s

# Maximum backoff delay between cancellation dispatch retries.
CONTRACT_CANCELLATION_SAGA_RETRY_MAX_DELAY=1m

# ------------------------------------------------------------------------------
# Payment Attempt Reconciliation Use Case
# ------------------------------------------------------------------------------
# Maximum number of payment attempts claimed per reconciliation job run.
PAYMENT_ATTEMPT_RECONCILIATION_BATCH_SIZE=100

# How long a payment attempt may remain in created state before reconciliation is requested.
PAYMENT_ATTEMPT_RECONCILIATION_CREATED_TIMEOUT=5m

# Extra grace after Financial Core session expiry before a submitted attempt is reconciled.
PAYMENT_ATTEMPT_RECONCILIATION_SUBMITTED_EXPIRY_GRACE=1m

# Initial delay before the next reconciliation request retry.
PAYMENT_ATTEMPT_RECONCILIATION_RETRY_BASE_DELAY=1s

# Maximum delay between reconciliation request retries.
PAYMENT_ATTEMPT_RECONCILIATION_RETRY_MAX_DELAY=1m

# Maximum automatic reconciliation generations before the attempt is moved to
# manual_review_required and removed from automatic retry scheduling.
PAYMENT_ATTEMPT_RECONCILIATION_MAX_ATTEMPTS=10

# ------------------------------------------------------------------------------
# Financial Core Payment Reconciliation Use Case
# ------------------------------------------------------------------------------
# Initial delay used when scheduling subsequent reconciliation checks after a
# still-reconciliation-required acknowledgement.
FINANCIAL_CORE_PAYMENT_RECONCILIATION_RETRY_BASE_DELAY=1s

# Maximum delay between inbound reconciliation processing retries.
FINANCIAL_CORE_PAYMENT_RECONCILIATION_RETRY_MAX_DELAY=1m

# ------------------------------------------------------------------------------
# External Credit Assessment Service
# ------------------------------------------------------------------------------
# External credit assessment signal provider used by customer initial-limit
# assignment before applying the code-owned initial credit limit policy.
# Supported values:
#   noop            return an empty signal set without calling an external service
#   creditbureau    future real external credit assessment integration (not implemented yet)
#
# Use noop for local development. Use creditbureau only when validating wiring
# for a future external integration.
EXTERNAL_CREDIT_ASSESSMENT_PROVIDER=noop

# ------------------------------------------------------------------------------
# External Webhook Dispatcher
# ------------------------------------------------------------------------------
# Outbound merchant webhook delivery adapter.
# Supported values:
#   http   signed HTTP POST delivery (default)
#   noop   acknowledge webhook:// outbox rows without HTTP (development/test only)
#
# Production rejects provider=noop at startup.
EXTERNAL_WEBHOOK_DISPATCHER_PROVIDER=http

# Bounds one whole webhook delivery attempt (connect, TLS, write, read).
EXTERNAL_WEBHOOK_DISPATCHER_HTTP_TIMEOUT=10s

# Bounds establishing one TCP connection for webhook delivery.
EXTERNAL_WEBHOOK_DISPATCHER_HTTP_DIAL_TIMEOUT=5s

# Maximum response body bytes read from a webhook endpoint before discard.
EXTERNAL_WEBHOOK_DISPATCHER_HTTP_MAX_RESPONSE_BYTES=65536

# ------------------------------------------------------------------------------
# External Financial Core
# ------------------------------------------------------------------------------
# Financial Core provider for checkout payment link creation.
# Supported values:
#   noop
#   grpc
EXTERNAL_FINANCIAL_CORE_PROVIDER=noop

# gRPC address of Financial Core.
EXTERNAL_FINANCIAL_CORE_GRPC_ADDRESS=127.0.0.1:50052

# Timeout for Financial Core gRPC calls.
EXTERNAL_FINANCIAL_CORE_GRPC_TIMEOUT=5s

# Use insecure gRPC transport for local development.
EXTERNAL_FINANCIAL_CORE_GRPC_INSECURE=true

# Identity Service (ResolveSubjectByMobile for partner checkout binding).
# Supported values:
#   noop
#   grpc
EXTERNAL_CUSTOMER_PROVIDER=noop

# gRPC address of the Identity Service.
EXTERNAL_CUSTOMER_GRPC_ADDRESS=127.0.0.1:50053

# Timeout for Identity Service gRPC calls.
EXTERNAL_CUSTOMER_GRPC_TIMEOUT=5s

# Use insecure gRPC transport for local development.
EXTERNAL_CUSTOMER_GRPC_INSECURE=true

# -----------------------------------------------------------------------------
# External Notification Service
# -----------------------------------------------------------------------------
# Provider used for durable notification submission (checkout OTP).
# Supported values:
#   noop
#   grpc
EXTERNAL_NOTIFICATION_PROVIDER=noop

# gRPC address of the Notification Service.
EXTERNAL_NOTIFICATION_GRPC_ADDRESS=127.0.0.1:50054

# Timeout for Notification Service gRPC calls.
EXTERNAL_NOTIFICATION_GRPC_TIMEOUT=5s

# Use insecure gRPC transport for local development.
EXTERNAL_NOTIFICATION_GRPC_INSECURE=true

# Bot messaging integrations.
# noop is mutually exclusive with Telegram/Bale. Telegram and Bale may both be
# enabled at the same time. Leaving every flag false also falls back to noop for
# backward compatibility with older configuration files.
EXTERNAL_BOT_MESSAGING_NOOP_ENABLED=true

# Telegram Bot API (long polling). Token is obtained from BotFather.
# Run only one active poller per bot token; multi-replica production should use
# a singleton/leader listener or move inbound delivery to webhook mode.
EXTERNAL_BOT_MESSAGING_TELEGRAM_ENABLED=false
EXTERNAL_BOT_MESSAGING_TELEGRAM_TOKEN=
# Must be shorter than HTTP_CLIENT_RESPONSE_HEADER_TIMEOUT and HTTP_CLIENT_TIMEOUT.
EXTERNAL_BOT_MESSAGING_TELEGRAM_POLL_TIMEOUT=2s
EXTERNAL_BOT_MESSAGING_TELEGRAM_RETRY_BASE_DELAY=1s
EXTERNAL_BOT_MESSAGING_TELEGRAM_RETRY_MAX_DELAY=30s

# Bale Bot API (long polling).
# Run only one active poller per bot token; multi-replica production should use
# a singleton/leader listener or move inbound delivery to webhook mode.
EXTERNAL_BOT_MESSAGING_BALE_ENABLED=false
EXTERNAL_BOT_MESSAGING_BALE_TOKEN=
# Must be shorter than HTTP_CLIENT_RESPONSE_HEADER_TIMEOUT and HTTP_CLIENT_TIMEOUT.
EXTERNAL_BOT_MESSAGING_BALE_POLL_TIMEOUT=2s
EXTERNAL_BOT_MESSAGING_BALE_RETRY_BASE_DELAY=1s
EXTERNAL_BOT_MESSAGING_BALE_RETRY_MAX_DELAY=30s

# Backend-owned redirect URL sent to Financial Core after IPG checkout.
FINANCIAL_CORE_PAYMENT_RETURN_URL=https://bnpl.example/payments/return

# Checkout payment request defaults.
EXTERNAL_FINANCIAL_CORE_CHECKOUT_PAYMENT_TENANT_ID=
EXTERNAL_FINANCIAL_CORE_CHECKOUT_PAYMENT_CONTEXT_ID=
EXTERNAL_FINANCIAL_CORE_CHECKOUT_PAYMENT_SOURCE_SERVICE=bnpl-backend
EXTERNAL_FINANCIAL_CORE_CHECKOUT_PAYMENT_SOURCE_TYPE=bnpl_contract
EXTERNAL_FINANCIAL_CORE_CHECKOUT_PAYMENT_SOURCE_VERSION=1
EXTERNAL_FINANCIAL_CORE_CHECKOUT_PAYMENT_PAYER_TYPE=subject
EXTERNAL_FINANCIAL_CORE_CHECKOUT_PAYMENT_PAYEE_TYPE=platform
EXTERNAL_FINANCIAL_CORE_CHECKOUT_PAYMENT_PAYEE_ID=
EXTERNAL_FINANCIAL_CORE_CHECKOUT_PAYMENT_PROVIDER_CODE=
EXTERNAL_FINANCIAL_CORE_CHECKOUT_PAYMENT_DESCRIPTION=

# -----------------------------------------------------------------------------
# Clock
# -----------------------------------------------------------------------------
# Time zone used for infrastructure-level concerns such as log timestamps,
# background jobs, metrics, and technical scheduling.
#
# This should normally be UTC in all environments.
SYSTEM_CLOCK_LOCATION=UTC

# Time zone used for business rules and customer-facing date/time calculations.
#
# Examples:
# - installment due dates
# - payment deadlines
# - grace periods
# - legal and regulatory cut-off times
#
# For Iranian business operations this is typically Asia/Tehran.
BUSINESS_CLOCK_LOCATION=Asia/Tehran

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Logger implementation provider.
# Supported values:
#   noop
#   slog
#
# Use "slog" for normal application logging.
# Use "noop" only for tests or environments where logs must be discarded.

# Metrics provider. Supported values: noop, prometheus.
METRICS_PROVIDER=prometheus

# Starts the dedicated internal Prometheus scrape HTTP server when the
# prometheus provider is selected. Keep this endpoint off public ingress.
METRICS_ENABLED=true

# Dedicated metrics listener bind address (separate from the application API).
METRICS_HOST=0.0.0.0
METRICS_PORT=9090

# Internal Prometheus scrape path on the metrics listener.
METRICS_PATH=/metrics

LOG_PROVIDER=slog

# Log verbosity level used when LOG_PROVIDER=slog.
# Supported values:
#   debug
#   info
#   warn
#   error
#
# Production environments typically use "info".
# Development environments commonly use "debug".
LOG_LEVEL=debug

# Log output format used when LOG_PROVIDER=slog.
# Supported values:
#   json
#   text
#
# JSON is recommended for production because it is easier to ingest by
# centralized logging systems.
# Text format is primarily intended for local development.
LOG_FORMAT=json


# -----------------------------------------------------------------------------
# Error reporting
# -----------------------------------------------------------------------------

# Error-reporting provider.
# Supported values: noop | sentry
# Keep noop for local/test environments when external reporting is not needed.
ERROR_REPORTING_PROVIDER=noop

# Sentry project DSN. Required only when ERROR_REPORTING_PROVIDER=sentry.
SENTRY_DSN=

# Optional Sentry environment override. Empty falls back to APP_ENVIRONMENT.
SENTRY_ENVIRONMENT=

# Immutable deployed release identifier, preferably a Git commit SHA or version.
SENTRY_RELEASE=

# Error-event sample rate. Must be > 0 and <= 1 when Sentry is enabled.
SENTRY_SAMPLE_RATE=1.0

# SDK diagnostic output. Keep false in production unless troubleshooting.
SENTRY_DEBUG=false

# -----------------------------------------------------------------------------
# Outbound HTTP/HTTPS Client
# -----------------------------------------------------------------------------
# Shared provider used by adapters that call third-party HTTP/HTTPS APIs.
# Supported values:
#   noop      reject every outbound HTTP request without network I/O
#   standard  bounded shared net/http client
#
# Production configuration rejects noop. External business adapters may still
# have their own provider/noop settings independently.
HTTP_CLIENT_PROVIDER=standard

# Maximum number of concurrent outbound requests. This is the effective
# worker-pool capacity, implemented without dedicated worker goroutines.
HTTP_CLIENT_MAX_IN_FLIGHT=50

# Maximum callers allowed to wait when all in-flight slots are occupied.
# Set to 0 for fail-fast behavior with no waiting queue.
HTTP_CLIENT_MAX_QUEUE_SIZE=100

# Maximum time a request may wait for an execution slot before failing.
HTTP_CLIENT_QUEUE_WAIT_TIMEOUT=500ms

# End-to-end net/http.Client timeout, including response body reads.
HTTP_CLIENT_TIMEOUT=5s

# TCP connection establishment timeout.
HTTP_CLIENT_DIAL_TIMEOUT=2s

# TLS handshake timeout for HTTPS endpoints.
HTTP_CLIENT_TLS_HANDSHAKE_TIMEOUT=2s

# Maximum wait for response headers after the request is written.
HTTP_CLIENT_RESPONSE_HEADER_TIMEOUT=3s

# How long reusable idle keep-alive connections remain in the pool.
HTTP_CLIENT_IDLE_CONN_TIMEOUT=90s

# Total idle keep-alive connections retained across all external hosts.
HTTP_CLIENT_MAX_IDLE_CONNS=100

# Idle keep-alive connections retained per external host.
HTTP_CLIENT_MAX_IDLE_CONNS_PER_HOST=20

# Total active+dialing+idle transport connections allowed per host.
HTTP_CLIENT_MAX_CONNS_PER_HOST=50

# -----------------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------------
# Cache provider used by the application.
# Supported values:
#   noop
#   redis
#
# Use noop when cache is disabled or not available.
CACHE_PROVIDER=noop

# Redis server address.
# Examples:
#   127.0.0.1:6379
#   redis:6379
CACHE_REDIS_ADDR=127.0.0.1:6379

# Redis username used for ACL authentication.
# Leave empty when ACL users are not configured.
CACHE_REDIS_USERNAME=

# Redis password.
# Leave empty when authentication is disabled.
CACHE_REDIS_PASSWORD=

# Redis logical database number.
CACHE_REDIS_DB=0

# Maximum time allowed to establish a new Redis connection.
CACHE_REDIS_DIAL_TIMEOUT=5s

# Maximum duration for Redis read operations.
CACHE_REDIS_READ_TIMEOUT=3s

# Maximum duration for Redis write operations.
CACHE_REDIS_WRITE_TIMEOUT=3s

# Maximum number of connections managed by the Redis pool.
CACHE_REDIS_POOL_SIZE=10

# Minimum number of idle connections kept in the pool.
CACHE_REDIS_MIN_IDLE_CONNS=1

# -----------------------------------------------------------------------------
# Object Storage
# -----------------------------------------------------------------------------
# noop | filesystem
# Filesystem is for local development/integration tests only. Production archival
# should add an S3-compatible provider behind the same core Store contract.
OBJECT_STORAGE_PROVIDER=filesystem
OBJECT_STORAGE_FILESYSTEM_ROOT_DIR=.local/object-storage

# -----------------------------------------------------------------------------
# Messaging
# -----------------------------------------------------------------------------
# Messaging provider used by the application.
# Supported values:
#   noop
#   kafka
#
# Use noop when messaging is disabled or not required in the environment.
MESSAGING_PROVIDER=noop

# Kafka broker addresses.
# For local development:
#   127.0.0.1:9092
#
# For container-to-container deployments:
#   kafka:9092
#
# For Hamravesh/Kubernetes-like service discovery:
#   kafka.parstis-technology-stage.svc:9092
KAFKA_BROKER_1=127.0.0.1:9092

# Kafka client identifier used by producers and consumers.
KAFKA_CLIENT_ID=bnpl-backend

# Kafka consumer group identifier.
KAFKA_GROUP_ID=bnpl-consumer-group

# Topic carrying payment gateway or financial-core payment results.
KAFKA_TOPIC_PAYMENT_RESULTS=financial-core.payment-results

# Kafka topic used to publish immutable BNPL audit events.
KAFKA_TOPIC_AUDIT_EVENTS=bnpl.audit.events.v1

# Kafka destination for BNPL payment-application acknowledgement outbox messages.
# This is the physical topic name; event type remains bnpl.payment_application_result.v1.
KAFKA_TOPIC_PAYMENT_APPLICATION_RESULTS=financial_core.payment_application_results

# Kafka destination for BNPL installment payment request outbox messages.
KAFKA_TOPIC_INSTALLMENT_PAYMENT_REQUESTS=financial_core.installment_payment_requests

# Kafka topic carrying Financial Core installment payment-session-created events.
KAFKA_TOPIC_INSTALLMENT_PAYMENT_SESSIONS=financial_core.installment_payment_sessions

# Kafka destination for BNPL installment payment reconciliation request outbox messages.
# Event type remains bnpl.installment_payment_reconciliation_requested.v1.
KAFKA_TOPIC_INSTALLMENT_PAYMENT_RECONCILIATION_REQUESTS=bnpl.installment_payment_reconciliation_requests

# Kafka topic carrying Financial Core installment payment reconciliation result events.
# Event type remains financial_core.installment_payment_reconciliation_result.v1.
KAFKA_TOPIC_INSTALLMENT_PAYMENT_RECONCILIATION_RESULTS=financial_core.installment_payment_reconciliation_results

# Kafka destination for BNPL installment payment reconciliation acknowledgement outbox messages.
# Event type remains bnpl.installment_payment_reconciliation_acknowledged.v1.
KAFKA_TOPIC_INSTALLMENT_PAYMENT_RECONCILIATION_ACKNOWLEDGEMENTS=bnpl.installment_payment_reconciliation_acknowledgements

# Kafka required acknowledgements for producer writes.
#
# Common values:
#   0   do not wait for broker acknowledgement
#   1   wait for leader acknowledgement
#  -1   wait for all in-sync replicas
#
# For financial events, -1 is recommended.
KAFKA_PRODUCER_REQUIRED_ACKS=-1

# Maximum number of producer retries before returning an error.
KAFKA_PRODUCER_MAX_RETRIES=5

# Whether the producer should emit success notifications after broker ack.
KAFKA_PRODUCER_RETURN_SUCCESSES=true

# Consumer topic for payment result processing.
KAFKA_CONSUMER_TOPIC_PAYMENT_RESULTS=financial-core.payment-results

# Kafka topic consumed for Financial Core installment payment-session-created events.
KAFKA_CONSUMER_TOPIC_INSTALLMENT_PAYMENT_SESSIONS=financial_core.installment_payment_sessions

# Kafka topic consumed for Financial Core installment payment reconciliation result events.
# Prefer matching KAFKA_TOPIC_INSTALLMENT_PAYMENT_RECONCILIATION_RESULTS.
KAFKA_CONSUMER_TOPIC_INSTALLMENT_PAYMENT_RECONCILIATION_RESULTS=financial_core.installment_payment_reconciliation_results

# Consumer offset policy used when a consumer group has no committed offset.
# Supported values:
#   oldest   start from the earliest available offset (recommended for local/dev)
#   newest   start from the end of the topic (skipped backlog; blocked in production)
KAFKA_CONSUMER_INITIAL_OFFSET=oldest

# Explicit opt-in for initial_offset=newest outside production.
# Must remain false unless intentionally skipping backlog in non-production.
KAFKA_CONSUMER_ALLOW_NEWEST_INITIAL_OFFSET=false

# Initial backoff before retrying a failed consumer handler.
KAFKA_CONSUMER_RETRY_INITIAL_BACKOFF=1s

# Maximum backoff between consumer handler retries.
KAFKA_CONSUMER_RETRY_MAX_BACKOFF=1m

# Durable quarantine topic for malformed/unsupported messages that handlers mark
# non-retryable. The source offset is committed only after this publish succeeds.
KAFKA_CONSUMER_QUARANTINE_TOPIC=bnpl.consumer.quarantine.v1

# -----------------------------------------------------------------------------
# Task Runner
# -----------------------------------------------------------------------------
# Task execution provider.
# Supported values:
#   - noop       (development/test only; rejected in production)
#   - inprocess  (all jobs run in this process)
#   - temporal   (all jobs run through Temporal)
#   - composite  (fixed inprocess + temporal; each enabled job selects execution)
TASK_PROVIDER=inprocess

# Default timezone used by the in-process scheduler when a task-specific
# timezone is not configured.
TASK_INPROCESS_DEFAULT_TIMEZONE=Asia/Tehran

# Process-wide upper bound for concurrent scheduled and dispatched jobs.
TASK_INPROCESS_MAX_CONCURRENT_RUNS=64

# Temporal frontend gRPC endpoint used by the BNPL application/worker.
TASK_TEMPORAL_ADDRESS=127.0.0.1:7233

# Host port exposed by the standalone Temporal Web UI in docker-compose.local.yml.
# Open http://127.0.0.1:${TEMPORAL_UI_PORT} in a browser during local development.
# This only configures the local Docker UI and is not used by the BNPL runtime.
TEMPORAL_UI_PORT=8233

# Temporal namespace used for BNPL background task workflows.
TASK_TEMPORAL_NAMESPACE=default

# Temporal task queue polled by the BNPL worker.
TASK_TEMPORAL_TASK_QUEUE=bnpl

# Safety bound for the generic Activity wrapping the existing task.Job.
# Existing jobs continue to own business retry/idempotency semantics.
TASK_TEMPORAL_ACTIVITY_START_TO_CLOSE_TIMEOUT=1h

# Zero delegates to Temporal SDK defaults.
TASK_TEMPORAL_MAX_CONCURRENT_ACTIVITIES=100
TASK_TEMPORAL_MAX_CONCURRENT_WORKFLOW_TASKS=100

# Enable when the Temporal frontend requires TLS.
TASK_TEMPORAL_TLS_ENABLED=false
TASK_TEMPORAL_TLS_SERVER_NAME=

# The TASK_*_EXECUTION variables below are used only when TASK_PROVIDER=composite.
# Allowed values are: inprocess, temporal. Keep them empty for standalone
# providers (noop, inprocess, temporal).

# -----------------------------------------------------------------------------
# Runtime Goroutine Metrics Task
# -----------------------------------------------------------------------------
# Periodically logs the number of currently running goroutines.
TASK_RUNTIME_GOROUTINE_METRICS_ENABLED=false
TASK_RUNTIME_GOROUTINE_METRICS_EXECUTION=

# Stable task handler identifier.
TASK_RUNTIME_GOROUTINE_METRICS_HANDLER=runtime_goroutine_metrics

# Supported values:
#   manual
#   cron
#   interval
#   event
TASK_RUNTIME_GOROUTINE_METRICS_TRIGGER_TYPE=interval

# Cron expression used when trigger type is cron.
TASK_RUNTIME_GOROUTINE_METRICS_CRON=

# Timezone used for cron evaluation.
TASK_RUNTIME_GOROUTINE_METRICS_TIMEZONE=Asia/Tehran

# Interval used when trigger type is interval.
TASK_RUNTIME_GOROUTINE_METRICS_INTERVAL=15m

# Execute once immediately when the scheduler starts.
TASK_RUNTIME_GOROUTINE_METRICS_RUN_ON_START=true

# ------------------------------------------------------------------------------
# Outbox Publisher Task
# ------------------------------------------------------------------------------
# Enable scheduled outbox publishing.
TASK_OUTBOX_PUBLISHER_ENABLED=true
TASK_OUTBOX_PUBLISHER_EXECUTION=

# Registered task handler name.
TASK_OUTBOX_PUBLISHER_HANDLER=outbox_publisher

# Trigger type.
# Supported values:
#   interval
#   cron
TASK_OUTBOX_PUBLISHER_TRIGGER_TYPE=interval

# Cron expression used when trigger type is cron.
TASK_OUTBOX_PUBLISHER_CRON=

# Timezone used for cron schedules.
TASK_OUTBOX_PUBLISHER_TIMEZONE=UTC

# Execution interval used when trigger type is interval.
TASK_OUTBOX_PUBLISHER_INTERVAL=5s

# Execute once immediately during startup.
TASK_OUTBOX_PUBLISHER_RUN_ON_START=true

# ------------------------------------------------------------------------------
# Installment Offer Expiry Task
# ------------------------------------------------------------------------------
# Enable scheduled expiry of unattached offered checkout installments
# (handled by installmentlifecycleuc via handler installment_offer_expiry).
TASK_INSTALLMENT_OFFER_EXPIRY_ENABLED=false
TASK_INSTALLMENT_OFFER_EXPIRY_EXECUTION=

# Registered task handler name.
TASK_INSTALLMENT_OFFER_EXPIRY_HANDLER=installment_offer_expiry

# Trigger type.
# Supported values:
#   interval
#   cron
TASK_INSTALLMENT_OFFER_EXPIRY_TRIGGER_TYPE=interval

# Cron expression used when trigger type is cron.
TASK_INSTALLMENT_OFFER_EXPIRY_CRON=

# Timezone used for cron schedules.
TASK_INSTALLMENT_OFFER_EXPIRY_TIMEZONE=UTC

# Execution interval used when trigger type is interval.
TASK_INSTALLMENT_OFFER_EXPIRY_INTERVAL=1m

# Execute once immediately during startup.
TASK_INSTALLMENT_OFFER_EXPIRY_RUN_ON_START=true

# ------------------------------------------------------------------------------
# Scheduled Task: Contract Payment Pending Expiry
# ------------------------------------------------------------------------------
TASK_CONTRACT_PAYMENT_PENDING_EXPIRY_ENABLED=false
TASK_CONTRACT_PAYMENT_PENDING_EXPIRY_EXECUTION=
TASK_CONTRACT_PAYMENT_PENDING_EXPIRY_HANDLER=contract_payment_pending_expiry
TASK_CONTRACT_PAYMENT_PENDING_EXPIRY_TRIGGER_TYPE=interval
TASK_CONTRACT_PAYMENT_PENDING_EXPIRY_CRON=
TASK_CONTRACT_PAYMENT_PENDING_EXPIRY_TIMEZONE=UTC
TASK_CONTRACT_PAYMENT_PENDING_EXPIRY_INTERVAL=1m
TASK_CONTRACT_PAYMENT_PENDING_EXPIRY_RUN_ON_START=true

# ------------------------------------------------------------------------------
# Scheduled Task: Checkout Session Expiry
# ------------------------------------------------------------------------------
TASK_CHECKOUT_SESSION_EXPIRY_ENABLED=false
TASK_CHECKOUT_SESSION_EXPIRY_EXECUTION=
TASK_CHECKOUT_SESSION_EXPIRY_HANDLER=checkout_session_expiry
TASK_CHECKOUT_SESSION_EXPIRY_TRIGGER_TYPE=interval
TASK_CHECKOUT_SESSION_EXPIRY_CRON=
TASK_CHECKOUT_SESSION_EXPIRY_TIMEZONE=UTC
TASK_CHECKOUT_SESSION_EXPIRY_INTERVAL=1m
TASK_CHECKOUT_SESSION_EXPIRY_RUN_ON_START=true

TASK_CHECKOUT_SESSION_CONFIRMING_RECOVERY_ENABLED=false
TASK_CHECKOUT_SESSION_CONFIRMING_RECOVERY_EXECUTION=
TASK_CHECKOUT_SESSION_CONFIRMING_RECOVERY_HANDLER=checkout_session_confirming_recovery
TASK_CHECKOUT_SESSION_CONFIRMING_RECOVERY_TRIGGER_TYPE=interval
TASK_CHECKOUT_SESSION_CONFIRMING_RECOVERY_CRON=
TASK_CHECKOUT_SESSION_CONFIRMING_RECOVERY_TIMEZONE=UTC
TASK_CHECKOUT_SESSION_CONFIRMING_RECOVERY_INTERVAL=1m
TASK_CHECKOUT_SESSION_CONFIRMING_RECOVERY_RUN_ON_START=true

# Scrubs ciphertext from expired merchant terminal issuance deliveries into
# idempotency tombstones (row kept; secret material cleared).
TASK_MERCHANT_TERMINAL_ISSUANCE_SCRUB_ENABLED=false
TASK_MERCHANT_TERMINAL_ISSUANCE_SCRUB_EXECUTION=
TASK_MERCHANT_TERMINAL_ISSUANCE_SCRUB_HANDLER=merchant_terminal_issuance_scrub
TASK_MERCHANT_TERMINAL_ISSUANCE_SCRUB_TRIGGER_TYPE=interval
TASK_MERCHANT_TERMINAL_ISSUANCE_SCRUB_CRON=
TASK_MERCHANT_TERMINAL_ISSUANCE_SCRUB_TIMEZONE=UTC
TASK_MERCHANT_TERMINAL_ISSUANCE_SCRUB_INTERVAL=5m
TASK_MERCHANT_TERMINAL_ISSUANCE_SCRUB_RUN_ON_START=true

# ------------------------------------------------------------------------------
# Scheduled Task: Saga Executor
# ------------------------------------------------------------------------------
# Resumes due Saga instances, including retries and pending compensation work.
TASK_SAGA_EXECUTOR_ENABLED=true
TASK_SAGA_EXECUTOR_EXECUTION=
TASK_SAGA_EXECUTOR_HANDLER=saga_executor
TASK_SAGA_EXECUTOR_TRIGGER_TYPE=interval
TASK_SAGA_EXECUTOR_CRON=
TASK_SAGA_EXECUTOR_TIMEZONE=UTC
TASK_SAGA_EXECUTOR_INTERVAL=10s
TASK_SAGA_EXECUTOR_RUN_ON_START=true

# ------------------------------------------------------------------------------
# Scheduled Task: Installment Mark Due
# ------------------------------------------------------------------------------
TASK_INSTALLMENT_MARK_DUE_ENABLED=false
TASK_INSTALLMENT_MARK_DUE_EXECUTION=
TASK_INSTALLMENT_MARK_DUE_HANDLER=installment_mark_due
TASK_INSTALLMENT_MARK_DUE_TRIGGER_TYPE=interval
TASK_INSTALLMENT_MARK_DUE_CRON=
TASK_INSTALLMENT_MARK_DUE_TIMEZONE=UTC
TASK_INSTALLMENT_MARK_DUE_INTERVAL=1m
TASK_INSTALLMENT_MARK_DUE_RUN_ON_START=true

# ------------------------------------------------------------------------------
# Scheduled Task: Installment Mark Overdue
# ------------------------------------------------------------------------------
TASK_INSTALLMENT_MARK_OVERDUE_ENABLED=false
TASK_INSTALLMENT_MARK_OVERDUE_EXECUTION=
TASK_INSTALLMENT_MARK_OVERDUE_HANDLER=installment_mark_overdue
TASK_INSTALLMENT_MARK_OVERDUE_TRIGGER_TYPE=interval
TASK_INSTALLMENT_MARK_OVERDUE_CRON=
TASK_INSTALLMENT_MARK_OVERDUE_TIMEZONE=UTC
TASK_INSTALLMENT_MARK_OVERDUE_INTERVAL=1m
TASK_INSTALLMENT_MARK_OVERDUE_RUN_ON_START=true

# ------------------------------------------------------------------------------
# Scheduled Task: Payment Attempt Reconciliation
# ------------------------------------------------------------------------------
# Enable scheduled payment-attempt reconciliation against Financial Core.
TASK_PAYMENT_ATTEMPT_RECONCILIATION_ENABLED=false
TASK_PAYMENT_ATTEMPT_RECONCILIATION_EXECUTION=

# Trigger type.
# Supported values:
#   interval
#   cron
TASK_PAYMENT_ATTEMPT_RECONCILIATION_TRIGGER_TYPE=interval

# Cron expression used when trigger type is cron.
TASK_PAYMENT_ATTEMPT_RECONCILIATION_CRON=

# Timezone used for cron schedules.
TASK_PAYMENT_ATTEMPT_RECONCILIATION_TIMEZONE=UTC

# Execution interval used when trigger type is interval.
TASK_PAYMENT_ATTEMPT_RECONCILIATION_INTERVAL=1m

# Execute once immediately during startup.
TASK_PAYMENT_ATTEMPT_RECONCILIATION_RUN_ON_START=true

# ------------------------------------------------------------------------------
# Circuit Breaker
# ------------------------------------------------------------------------------
# Circuit breaker provider.
# Supported values:
#   noop
#   gobreaker
CIRCUIT_BREAKER_PROVIDER=gobreaker

# Maximum number of requests allowed while the circuit is half-open.
CIRCUIT_BREAKER_GOBREAKER_MAX_REQUESTS=3

# Interval for clearing internal counters while the circuit is closed.
CIRCUIT_BREAKER_GOBREAKER_INTERVAL=60s

# Duration the circuit stays open before trying half-open requests.
CIRCUIT_BREAKER_GOBREAKER_TIMEOUT=30s

# Number of consecutive failures required to open the circuit.
CIRCUIT_BREAKER_GOBREAKER_FAILURE_THRESHOLD=5
