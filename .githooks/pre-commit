#!/usr/bin/env bash

# Runs project checks before creating a commit.
#
# Checks:
#   - golangci-lint configuration validity
#   - go.mod and go.sum tidiness
#   - lint, vet, static analysis, and formatting rules
#
# Bypass only when absolutely necessary:
#   git commit --no-verify

set -euo pipefail

# shellcheck disable=SC2155
readonly PROJECT_ROOT="$(git rev-parse --show-toplevel)"

cd "${PROJECT_ROOT}"

fail() {
  echo
  echo "FAIL: $1"
  echo
  exit 1
}

echo "Running pre-commit checks..."

if ! command -v go >/dev/null 2>&1; then
  fail "Go is not installed or is not available in PATH."
fi

if ! command -v golangci-lint >/dev/null 2>&1; then
  fail "golangci-lint is not installed or is not available in PATH."
fi

if [[ ! -f ".golangci.yml" && ! -f ".golangci.yaml" ]]; then
  fail "golangci-lint configuration file was not found."
fi

echo
echo "1/3 Verifying golangci-lint configuration..."

if ! golangci-lint config verify; then
  fail "golangci-lint configuration is invalid."
fi

echo
echo "2/3 Checking go.mod and go.sum..."

if ! go mod tidy -diff; then
  echo
  echo "go.mod or go.sum is not tidy."
  echo "Run the following command and stage the changes:"
  echo
  echo "  go mod tidy"
  echo "  git add go.mod go.sum"
  echo
  exit 1
fi

echo
echo "3/3 Running golangci-lint..."

if ! golangci-lint run ./...; then
  fail "golangci-lint reported one or more issues."
fi

echo
echo "PASS: all pre-commit checks completed successfully."
