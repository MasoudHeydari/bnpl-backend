### Go ###
# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

### GoLand ###
# Covers JetBrains IDEs: IntelliJ, RubyMine, PhpStorm, AppCode, PyCharm, CLion, Android Studio, WebStorm and Rider
# Reference: https://intellij-support.jetbrains.com/hc/en-us/articles/206544839

# User-specific stuff
.idea

# CMake
cmake-build-*/

# File-based project format
*.iws

# IntelliJ
out/
build/bin/*

# JIRA plugin
atlassian-ide-plugin.xml

# Crashlytics plugin (for Android Studio and IntelliJ)
com_crashlytics_export_strings.xml
crashlytics.properties
crashlytics-build.properties
fabric.properties

# .pgpass file directory
dist
*.env
doc/collections/http-client.env.json

# Ignore Cursor local state, but keep the always-on test-verification rule.
.cursor/

.codex/
.claude/
graphify-out/
AGENTS.md
# Retain the legacy ignore rule to avoid accidentally committing local historical CSV files.
assets/csv/trusted-subjects/*.csv
assets/csv/trusted-customers/*.csv
# Development-only TLS keys and local overrides.
assets/local-development/**/*.key
assets/local-development/**/*-key.pem
assets/local-development/**/.env
# Outbound mTLS PEMs for FC/customer/notification (keep README tracked).
assets/local-development/certs/*
!assets/local-development/certs/README.md
# Grafana admin Docker secret for local Loki stack.
assets/local-development/secrets/bnpl_loki_grafana_password
# Local host log files collected by Promtail (keep directory .gitkeep files).
assets/local-development/logs/**/*.log
assets/local-development/logs/**/*.json
.gocache
