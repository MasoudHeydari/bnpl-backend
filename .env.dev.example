# Compose-level variables for docker-compose.dev.yml (dpay / Hamravesh-dev).
# Copy selected lines into your local .env (gitignored) or export them.

# Public hostnames (TLS SAN must match)
DEV_PUBLIC_HOST=dev.dlend.ir
CHECKOUT_SESSION_PUBLIC_ORIGIN=https://api.dev.dlend.ir
CHECKOUT_SESSION_PUBLIC_ORIGIN_ALLOWED_HOST=api.dev.dlend.ir
SHORT_LINK_PUBLIC_HOST=s.dev.dlend.ir

# Bind for non-public debug ports (Postgres/Redis/Temporal admin). Use 0.0.0.0 only if intentional.
DPAY_PUBLISH_BIND=127.0.0.1

POSTGRES_DB=bnpl
POSTGRES_USER=dpay
POSTGRES_PASSWORD=change-me-now

TEMPORAL_UI_PORT=8233

# Optional image overrides (defaults pin handoff digests / bnpl development tag)
# IDENTITY_IMAGE=registry.hamdocker.ir/parstis-technology/identity-service@sha256:...
# CUSTOMER_IMAGE=...
# FINANCIAL_CORE_IMAGE=...
# NOTIFICATION_IMAGE=...
# BNPL_IMAGE=registry.hamdocker.ir/parstis-technology/bnpl-backend:v0.1.0-development
# BNPL_DBADMIN_IMAGE=registry.hamdocker.ir/parstis-technology/bnpl-backend-dbadmin:v0.1.0-development
