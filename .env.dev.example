# Compose-level variables for docker-compose.dev.yml (dpay / Hamravesh-dev).
# Copy selected lines into your local .env (gitignored) or set the same keys in
# the Hamravesh ENV panel. Hamravesh does not accept env_file host paths.

# Public hostnames (TLS SAN must match)
DEV_PUBLIC_HOST=dev.dlend.ir
CHECKOUT_SESSION_PUBLIC_ORIGIN=https://api.dev.dlend.ir
CHECKOUT_SESSION_PUBLIC_ORIGIN_ALLOWED_HOST=api.dev.dlend.ir
SHORT_LINK_PUBLIC_HOST=s.dev.dlend.ir

POSTGRES_DB=bnpl
POSTGRES_USER=dpay
POSTGRES_PASSWORD=change-me-now

# BNPL config path inside the image (override in Hamravesh if needed)
CONFIG_FILE=configs/runtime.yaml
BNPL_DBADMIN_CONFIG_FILE=configs/dbadmin.yaml

# Platform secrets: set every REPLACE_* key from the handoff *.env.example.json
# in Hamravesh (or here). Examples:
# GATEWAY_TRUST_PROOF=...
# IDENTITY_DB_PASSWORD=...
# IDENTITY_ACCESS_JWT_PRIVATE_KEY_PEM_BASE64=...
